let cpuEjecutando = true;

function cicloDeInstruccion() {
  if (!cpuEjecutando) return;

  // 1. FETCH (Búsqueda)
  MAR = PC;
  MDR = Read(MAR);
  IR = MDR;
  PC++;

  // 2. DECODE (Decodificación)
  let opcode = IR;
  let operando = 0;

  // Si la instrucción requiere operando de 1 byte adicional
  if ([0x10, 0x11, 0x20, 0x21, 0x30, 0x31, 0x40, 0x50, 0x80, 0x90, 0xA0, 0xB0].includes(opcode)) {
    MAR = PC;
    operando = Read(MAR);
    PC++;
  }

  // 3. EXECUTE (Ejecución) & 4. STORE (Almacenamiento / Write-back)
  switch (opcode) {
    case 0x10: // MOV AX, imm
      AX = operando;
      break;
    case 0x40: // ADD AX, imm
      AX = actualizarBanderas(AX + operando);
      break;
    case 0x70: // DEC AX
      AX = actualizarBanderas(AX - 1);
      break;
    case 0xB0: // JNZ dir
      if (Flags.ZF === 0) PC = operando;
      break;
    case 0x30: // STORE [dir], AX
      MAR = operando;
      MDR = AX;
      Write(MAR, MDR);
      break;
    case 0xFF: // HLT
      cpuEjecutando = false;
      registrarLog("SISTEMA DETENIDO (HLT DETECTADO)");
      break;
  }
}
